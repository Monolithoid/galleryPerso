# Installation-specific values, for caddy/compose-avec-caddy.example.yml.
# Copy into the .env next to Caddy's docker-compose
# (docker compose reads it on its own), adapting each path.

# galleryPerso clone folder (image build, login pages)
SITEIMAGEPERSO_SOURCES=/srv/apps/galleryPerso
# Photos and videos, one gallery per folder
SITEIMAGEPERSO_GALLERY_PHOTOS=/var/www/famille.example.com/GalleryPhotos
SITEIMAGEPERSO_GALLERY_CREATIVE=/var/www/famille.example.com/GalleryCreative
# Thumbnails, previews and converted videos (can be deleted)
SITEIMAGEPERSO_CACHE=/srv/apps/galerie/cache
# Site configuration: emails.txt, and journal/ for failed media
SITEIMAGEPERSO_CONFIG=/srv/apps/galerie/config

# Google login
# Public site address, without a trailing / (the same as in the Caddyfile)
SITEIMAGEPERSO_PUBLIC_URL=https://famille.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random characters: openssl rand -hex 16
SITEIMAGEPERSO_COOKIE_SECRET=
