# Valeurs propres à l'installation, pour caddy/compose-avec-caddy.example.yml.
# À recopier dans le .env placé à côté du docker-compose de Caddy
# (docker compose le lit tout seul), en adaptant chaque chemin.

# Dossier du clone de galleryPerso (construction de l'image, pages de connexion)
SITEIMAGEPERSO_SOURCES=/srv/apps/galleryPerso
# Photos et vidéos, une galerie par dossier
SITEIMAGEPERSO_GALLERY_PHOTOS=/var/www/famille.example.com/GalleryPhotos
SITEIMAGEPERSO_GALLERY_CREATIVE=/var/www/famille.example.com/GalleryCreative
# Vignettes, aperçus et vidéos converties (peut être effacé)
SITEIMAGEPERSO_CACHE=/srv/apps/galerie/cache
# Configuration du site : emails.txt, et journal/ pour les médias en erreur
SITEIMAGEPERSO_CONFIG=/srv/apps/galerie/config

# Connexion Google
# Adresse publique du site, sans / final (la même que dans le Caddyfile)
SITEIMAGEPERSO_PUBLIC_URL=https://famille.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 caractères aléatoires : openssl rand -hex 16
SITEIMAGEPERSO_COOKIE_SECRET=
