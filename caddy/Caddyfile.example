# Caddy devant le conteneur Docker (connexion Google comprise).
# Caddy obtient et renouvelle seul le certificat HTTPS.
# À recopier dans le Caddyfile du serveur (souvent /etc/caddy/Caddyfile),
# en remplaçant famille.example.com par l'adresse du site
# (la même que SITEIMAGEPERSO_PUBLIC_URL dans .env), puis :
#   sudo systemctl reload caddy

famille.example.com {
	# Demande aux moteurs de recherche de ne rien indexer, pas même la
	# page de connexion
	header X-Robots-Tag "noindex, nofollow"

	# Caddy installé sur le serveur : port SITEIMAGEPERSO_HTTP_PORT du fichier .env
	reverse_proxy 127.0.0.1:8080

	# Caddy dans un conteneur Docker, avec la galerie dans le même
	# docker-compose (voir compose-avec-caddy.example.yml) : remplacer la
	# ligne ci-dessus par
	#   reverse_proxy galerie-auth:4180
}
