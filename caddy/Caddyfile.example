# Caddy in front of the Docker container (Google login included).
# Caddy obtains and renews the HTTPS certificate by itself.
# Copy into the server's Caddyfile (often /etc/caddy/Caddyfile),
# replacing famille.example.com with the site address
# (the same as SITEIMAGEPERSO_PUBLIC_URL in .env), then:
#   sudo systemctl reload caddy

famille.example.com {
	# Asks search engines not to index anything, not even the
	# login page
	header X-Robots-Tag "noindex, nofollow"

	# Caddy installed on the server: port SITEIMAGEPERSO_HTTP_PORT from the .env file
	reverse_proxy 127.0.0.1:8080

	# Caddy in a Docker container, with the gallery in the same
	# docker-compose (see compose-avec-caddy.example.yml): replace the
	# line above with
	#   reverse_proxy galerie-auth:4180
}
