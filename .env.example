SITEIMAGEPERSO_HTTP_PORT=8080
SITEIMAGEPERSO_GALLERY_PHOTOS=./GalleryPhotos
SITEIMAGEPERSO_GALLERY_CREATIVE=./GalleryCreative
SITEIMAGEPERSO_CACHE=./cache
# Site configuration: emails.txt (allowed Google addresses)
SITEIMAGEPERSO_CONFIG=./config
SITEIMAGEPERSO_SCAN_INTERVAL=60
SITEIMAGEPERSO_MAX_WORKERS=10
SITEIMAGEPERSO_FFMPEG_THREADS=2
# 1 only behind an HTTPS reverse proxy that forwards X-Forwarded-Proto
SITEIMAGEPERSO_FORCE_HTTPS=0

# Google login (see README, "Google login")
# Public site address, without a trailing /: https://family.example.com
# (for a local test: http://localhost:8080 and SITEIMAGEPERSO_COOKIE_SECURE=false)
SITEIMAGEPERSO_PUBLIC_URL=https://famille.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random characters: openssl rand -hex 16
SITEIMAGEPERSO_COOKIE_SECRET=
# Time before having to log in again (720h = 30 days)
SITEIMAGEPERSO_SESSION_DURATION=720h
# false only for a local test over http://localhost
SITEIMAGEPERSO_COOKIE_SECURE=true
# 127.0.0.1: port reachable only from the server (HTTPS reverse proxy)
SITEIMAGEPERSO_HTTP_BIND=127.0.0.1
