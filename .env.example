SITEIMAGEPERSO_HTTP_PORT=8080
SITEIMAGEPERSO_GALLERY_PHOTOS=./GalleryPhotos
SITEIMAGEPERSO_GALLERY_CREATIVE=./GalleryCreative
SITEIMAGEPERSO_CACHE=./cache
SITEIMAGEPERSO_SCAN_INTERVAL=60
SITEIMAGEPERSO_MAX_WORKERS=10
SITEIMAGEPERSO_FFMPEG_THREADS=2
# 1 seulement derrière un reverse proxy HTTPS qui transmet X-Forwarded-Proto
SITEIMAGEPERSO_FORCE_HTTPS=0

# Connexion Google (voir README, « Connexion Google »)
# Adresse publique du site, sans / final : https://famille.example.com
# (en test local : http://localhost:8080 et SITEIMAGEPERSO_COOKIE_SECURE=false)
SITEIMAGEPERSO_PUBLIC_URL=https://famille.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 caractères aléatoires : openssl rand -hex 16
SITEIMAGEPERSO_COOKIE_SECRET=
# Adresses Google autorisées, séparées par des virgules
# (après une modification : docker compose up -d)
SITEIMAGEPERSO_ALLOWED_EMAILS=prenom.nom@gmail.com,autre.personne@exemple.fr
# Durée avant de devoir se reconnecter (720h = 30 jours)
SITEIMAGEPERSO_SESSION_DURATION=720h
# false seulement pour un test local en http://localhost
SITEIMAGEPERSO_COOKIE_SECURE=true
# 127.0.0.1 : port joignable seulement depuis le serveur (reverse proxy HTTPS)
SITEIMAGEPERSO_HTTP_BIND=127.0.0.1
